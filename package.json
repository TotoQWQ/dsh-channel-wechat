{
  "name": "dsh-channel-wechat",
  "version": "2.4.4",
  "private": true,
  "type": "module",
  "description": "WeChat ClawBot (iLink) channel: bidirectional mirroring between WeChat and DeepSeek Harness sessions",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "vendor/qrcode.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "install.mjs",
    "test-api.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/promo.gif",
    "docs/promo.mp4",
    "docs/promo-poster.png",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
